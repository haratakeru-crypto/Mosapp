<Window x:Class="MOS_Word_app.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="結果画面" 
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F5F5F5"
        Topmost="True">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#1E40AF" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="結果画面" 
                           Foreground="White" FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Name="CloseButton" Content="✕" 
                        Background="Transparent" Foreground="White" 
                        FontSize="20" FontWeight="Bold"
                        Width="40" Height="40"
                        BorderThickness="0"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#DC2626"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        
        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- タイトル -->
                <TextBlock Text="試験結果" 
                           FontSize="28" FontWeight="Bold" 
                           Foreground="#1E40AF" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <StackPanel x:Name="TotalScorePanel"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24"
                            Visibility="Collapsed">
                    <TextBlock x:Name="TotalScoreLabel"
                               Text="総合点"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalScoreTextBlock"
                               Text=""
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="#1E40AF"
                               HorizontalAlignment="Center"/>
                    <Border x:Name="PassingRangeBadge"
                            Background="#059669"
                            CornerRadius="6"
                            Padding="16,6"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock Text="合格圏内"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="LostPointsTextBlock"
                               Text=""
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#B91C1C"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="520"
                               Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Border Background="#1E40AF" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="優先" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text=" → " FontSize="14" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <Border Background="#D97706" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="次点" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="の順で、解けるようになりましょう"
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 統計情報 -->
                <Border Background="White" CornerRadius="8" Padding="30" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.1" BlurRadius="8"/>
                    </Border.Effect>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="正答率: " 
                                           FontSize="24" FontWeight="Bold" 
                                           Foreground="#374151"
                                           VerticalAlignment="Center"/>
                                <TextBlock Name="AccuracyTextBlock"
                                           Text="正答率: 初回 0.0% / 修正後 0.0%" 
                                           FontSize="32" FontWeight="Bold"
                                           Foreground="#1E40AF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="間違えた問題数: " 
                                           FontSize="20" FontWeight="Medium" 
                                           Foreground="#374151"
                                           VerticalAlignment="Center"/>
                                <TextBlock Name="WrongCountTextBlock" Text="0問" 
                                           FontSize="24" FontWeight="Bold" 
                                           Foreground="#DC2626"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Name="SummaryTextBlock" Visibility="Collapsed"/>
                        </Grid>

                        <!-- 座席表送信 / QR（点数の右） -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="24,0,0,0">
                            <TextBlock x:Name="SeatChartSubmitStatusText"
                                       Text="座席表へ送信中…"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="280"
                                       Margin="0,0,0,8"/>
                            <Image x:Name="SeatChartQrImage"
                                   Width="255" Height="255"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"
                                   ToolTip="QRコードを読み取って座席表に送ってください"/>
                        </StackPanel>

                        <!-- 間違えた問題のみ表示ボタン -->
                        <Button Grid.Column="2" Name="ShowWrongOnlyButton" Content="間違えた問題のみ表示" 
                                Background="#DC2626" Foreground="White" 
                                Padding="20,10" FontWeight="Medium" FontSize="14"
                                BorderThickness="0" Click="ShowWrongOnlyButton_Click"
                                VerticalAlignment="Center"
                                Margin="30,0,0,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#B91C1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- 説明テキスト -->
                <TextBlock Text="任意の問題に戻るには、その問題をクリックします。" 
                           FontSize="14" Foreground="#6B7280" 
                           Margin="0,0,0,20" HorizontalAlignment="Center"/>
                
                <!-- プロジェクト一覧 -->
                <ItemsControl Name="ProjectsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Margin="0,0,0,20" 
                                    Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.1" BlurRadius="8"/>
                                </Border.Effect>
                                
                                <StackPanel>
                                    <!-- プロジェクトタイトル -->
                                    <TextBlock Text="{Binding ProjectTitle}" 
                                               FontSize="20" FontWeight="Bold" 
                                               Foreground="#1E40AF" Margin="0,0,0,15"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#F8FAFC"
                                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowDispositionColumns, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="プロジェクト番号・タスク番号"
                                                           FontSize="19" FontWeight="Bold"
                                                           Foreground="#374151" Padding="15,10"/>
                                                <TextBlock Grid.Column="1" Text="解答済み"
                                                           FontSize="19" FontWeight="Bold"
                                                           Foreground="#374151" Padding="15,10"
                                                           HorizontalAlignment="Center" MinWidth="120"/>
                                                <TextBlock Grid.Column="2" Text="あとで見直す"
                                                           FontSize="19" FontWeight="Bold"
                                                           Foreground="#374151" Padding="15,10"
                                                           HorizontalAlignment="Center" MinWidth="120"/>
                                                <TextBlock Grid.Column="3" Text="結果"
                                                           FontSize="19" FontWeight="Bold"
                                                           Foreground="#374151" Padding="15,10"
                                                           HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                                                            MouseDown="TaskRow_MouseDown"
                                                            Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#E0F2FE"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsCompletedAndWrong}" Value="True">
                                                                        <Setter Property="Background" Value="#FECACA"/>
                                                                        <Setter Property="BorderBrush" Value="#F87171"/>
                                                                        <Setter Property="BorderThickness" Value="4,0,0,1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="160"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" Margin="15,10">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding TaskTitle}"
                                                                                   FontSize="19" FontWeight="SemiBold"
                                                                                   Foreground="#374151"
                                                                                   VerticalAlignment="Center"
                                                                                   TextWrapping="Wrap"/>
                                                                        <Border Margin="10,0,0,0"
                                                                                CornerRadius="4"
                                                                                Padding="8,2"
                                                                                VerticalAlignment="Center"
                                                                                Background="{Binding PriorityBadgeBackground}">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasPriorityBadge}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="{Binding PriorityBadgeText}"
                                                                                       FontSize="13"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{Binding PriorityBadgeForeground}"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Description}" 
                                                                               FontSize="17" Foreground="#6B7280" 
                                                                               TextWrapping="Wrap" LineHeight="21"/>
                                                                </StackPanel>

                                                                <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="120">
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowDispositionColumns}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <TextBlock Text="✓"
                                                                               FontSize="20"
                                                                               Foreground="#10B981"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>

                                                                <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="120">
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowDispositionColumns}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <TextBlock Text="🚩"
                                                                               FontSize="20"
                                                                               HorizontalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>

                                                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ResultMark}" 
                                                                               FontSize="20" FontWeight="Bold"
                                                                               Foreground="{Binding ResultColor}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="詳細" Tag="FailReason" Margin="10,0,0,0"
                                                                               FontSize="15" Foreground="#1E40AF"
                                                                               TextDecorations="Underline" Cursor="Hand"
                                                                               VerticalAlignment="Center"
                                                                               PreviewMouseLeftButtonDown="FailReason_PreviewMouseLeftButtonDown">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasFailReason}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <!-- フッター -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="結果を確認しました" 
                           Foreground="#6B7280" FontSize="14"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Name="CloseButtonFooter" Content="閉じる" 
                        Background="#1E40AF" Foreground="White" 
                        Padding="20,10" FontWeight="Medium"
                        BorderThickness="0" Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
