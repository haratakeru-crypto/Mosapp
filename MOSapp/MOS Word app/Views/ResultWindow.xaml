<Window x:Class="MOS_Word_app.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="試験結果" 
        WindowState="Maximized"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#1E40AF" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="試験結果" 
                           Foreground="White" FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Name="CloseButton" Content="✕" 
                        Background="Transparent" Foreground="White" 
                        FontSize="20" FontWeight="Bold"
                        Width="40" Height="40"
                        BorderThickness="0"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#DC2626"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        
        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- 結果サマリー -->
                <Border Background="White" CornerRadius="8" Margin="0,0,0,20" 
                        Padding="30" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.1" BlurRadius="8"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <TextBlock Text="結果サマリー" 
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="#1E40AF" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="✖の数: " 
                                       FontSize="18" FontWeight="SemiBold" 
                                       Foreground="#374151" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Name="WrongCountTextBlock" Text="0" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="#DC2626"/>
                        </Grid>
                        
                        <TextBlock Name="SummaryTextBlock" 
                                   Text="「あとで見直す」状態の問題と、50分以内に目を通せていない問題の合計数です。" 
                                   FontSize="14" Foreground="#6B7280" 
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- 説明テキスト -->
                <TextBlock Text="任意の問題に戻るには、その問題をクリックします。" 
                           FontSize="14" Foreground="#6B7280" 
                           Margin="0,0,0,20" HorizontalAlignment="Center"/>
                
                <!-- プロジェクト一覧 -->
                <ItemsControl Name="ProjectsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Margin="0,0,0,20" 
                                    Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.1" BlurRadius="8"/>
                                </Border.Effect>
                                
                                <StackPanel>
                                    <!-- プロジェクトタイトル -->
                                    <TextBlock Text="{Binding ProjectTitle}" 
                                               FontSize="20" FontWeight="Bold" 
                                               Foreground="#1E40AF" Margin="0,0,0,15"/>
                                    
                                    <!-- タスク一覧 -->
                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <Button Background="Transparent" 
                                                            Padding="15,10"
                                                            Cursor="Hand"
                                                            Click="TaskRow_MouseDown"
                                                            BorderThickness="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" 
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#E0F2FE"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding TaskTitle}" 
                                                                           FontSize="19" FontWeight="SemiBold" 
                                                                           Foreground="#374151" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding Description}" 
                                                                           FontSize="17" Foreground="#6B7280" 
                                                                           TextWrapping="Wrap" LineHeight="21"/>
                                                            </StackPanel>
                                                            
                                                            <!-- 結果マーク（✖ / 時間切れ） -->
                                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                                                <TextBlock Text="{Binding ResultMark}" 
                                                                           FontSize="20" FontWeight="Bold"
                                                                           Foreground="{Binding ResultColor}"
                                                                           HorizontalAlignment="Center"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <!-- フッター -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="結果を確認しました" 
                           Foreground="#6B7280" FontSize="14"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Name="CloseButtonFooter" Content="閉じる" 
                        Background="#1E40AF" Foreground="White" 
                        Padding="20,10" FontWeight="Medium"
                        BorderThickness="0" Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
