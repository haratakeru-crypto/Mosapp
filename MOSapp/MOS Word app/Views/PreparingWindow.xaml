<Window x:Class="MOS_Word_app.Views.PreparingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プロジェクト準備中"
        SizeToContent="WidthAndHeight"
        MinWidth="260"
        MaxWidth="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="White">
    <StackPanel Margin="16,14"
                MaxWidth="388">
        <TextBlock Text="プロジェクトを開いています。&#x0a;しばらくお待ちください..."
                   FontSize="14"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Stretch"
                   MaxWidth="356"/>
    </StackPanel>
</Window>
