<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
  <!--
    FontColorPicker・WatermarkGallery 等のギャラリーは Word の commands スキーマでフック不可（command のみ可）。透かしは ThisAddIn ポーリングで [Op] Watermark。
    ColumnsLeft/Right・ColumnBreak は Word で無効/未対応のため使わない。段組みは ColumnsDialog、段区切りは ThisAddIn ポーリング。
    InsertSectionBreakNextPage は環境で無効になり得るため SectionBreakInsert のみ。向きの縦横個別 id は省略（PageOrientationPortraitLandscape + ポーリング）。
    Word では PageBorders / PageBorderOptionsDialog は無効 id のため PageBorderAndShadingDialog のみ（Ribbon.cs で PageBorders ログに正規化）。
    StyleSetGallery は Word で不明 ID のため未接続。StyleSetLineSimple は ThisAddIn の見出し1下罫線ポーリングで記録。
    ShowAll も Word の Ribbon で不明 ID のため未接続。編集記号は ThisAddIn の View.ShowAll / Options.ShowAll ポーリングで記録（1-1）。
    4-3: ReviewResolveComment は Word で無効 id となるため未接続。ReviewDeleteComment のみフック。解決操作の採点はチェッカー側で Comment.Done を参照。
    4-7: 文書検査は FileInspectDocument / ReviewInspectDocument 等の idMso が環境により無効のため Ribbon 未接続。採点はヘッダー・フッター空の状態のみ。
    4-5 透かし: リボン XML 未接続。透かし指紋ポーリング + Snapshot 差分。
  -->
  <commands>
    <command idMso="Cut" onAction="CommandOnAction" />
    <command idMso="Copy" onAction="CommandOnAction" />
    <command idMso="Paste" onAction="CommandOnAction" />
    <command idMso="FontColorMoreColorsDialog" onAction="CommandOnAction" />
    <command idMso="PageOrientationPortraitLandscape" onAction="CommandOnAction" />
    <command idMso="ColumnsDialog" onAction="CommandOnAction" />
    <command idMso="SectionBreakInsert" onAction="CommandOnAction" />
    <command idMso="PageBorderAndShadingDialog" onAction="CommandOnAction" />
    <command idMso="ConvertTextToTable" onAction="CommandOnAction" />
    <command idMso="ReviewDeleteComment" onAction="CommandOnAction" />
    <command idMso="FileSaveAs" onAction="CommandOnAction" />
    <command idMso="TableColumnsDistribute" onAction="CommandOnAction" />
    <command idMso="AcceptAllChangesInDocAndStopTracking" onAction="CommandOnAction" />
    <!-- 注: UpgradeDocument は Office 仕様により idMso 経由で onAction フックが発火しない（実機検証で確認済み）。
         7-1 の採点ロジックは State-only（ext=.doc + CompatMode=15 のユニークシグネチャ）で実装されており、
         この登録には依存していない。将来 Office 側で対応された場合に備えて登録は残している。 -->
    <command idMso="UpgradeDocument" onAction="CommandOnAction" />
    <command idMso="BulletDefineNew" onAction="CommandOnAction" />
    <command idMso="ClearFormatting" onAction="CommandOnAction" />
  </commands>





  <ribbon>
    <tabs>
      <tab id="tabMOSDebug" label="MOSデバッグ" insertAfterMso="Help">
        <group id="grpLog" label="ログ">
          <button id="btnShowLogPath" label="ログパス表示" onAction="ShowLogPathButtonOnAction" />
          <button id="btnShowLogContent" label="ログ内容表示" onAction="ShowLogContentButtonOnAction" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
