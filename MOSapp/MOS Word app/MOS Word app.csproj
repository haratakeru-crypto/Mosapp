  <!-- 発行時に VSTO アドインの出力を publish\WordAddIn にコピーする（Import の後に定義して確実に実行されるようにする） -->
  <Target Name="AfterPublish">
    <PropertyGroup>
      <_AddInOutDir>$(ProjectDir)New_MOSWordVSTOAddIn\New_MOSWordVSTOAddIn\bin\$(Configuration)\</_AddInOutDir>
      <_AddInPublishDir>$(ProjectDir)$(PublishUrl)WordAddIn\</_AddInPublishDir>
    </PropertyGroup>
    <MakeDir Directories="$(_AddInPublishDir)" />
    <Exec Command="xcopy /Y /E &quot;$(_AddInOutDir)*.*&quot; &quot;$(_AddInPublishDir)&quot;" IgnoreExitCode="false" />
    <WriteLinesToFile File="$(_AddInPublishDir)README.txt" Lines="Word 用 VSTO アドイン（採点連携用）;;1. 本フォルダ内の New_MOSWordVSTOAddIn.vsto をダブルクリックしてインストールしてください。;2. 初回はセキュリティの警告が出る場合があります。信頼してインストールしてください。;3. インストール後、Word を起動するとアドインが読み込まれ、模擬アプリの採点が正しく動作します。" Overwrite="true" Encoding="UTF-8" />
    <Message Importance="high" Text="VSTO アドインを発行フォルダにコピーしました: $(_AddInPublishDir)" />
  </Target>
  <Target Name="RegisterReleaseWordVsto" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ReleaseVsto>$(ProjectDir)New_MOSWordVSTOAddIn\New_MOSWordVSTOAddIn\bin\Release\New_MOSWordVSTOAddIn.vsto</_ReleaseVsto>
      <_VstoInstaller>$(CommonProgramFiles)\Microsoft Shared\VSTO\10.0\VSTOInstaller.exe</_VstoInstaller>
    </PropertyGroup>
    <Exec Condition="Exists('$(_ReleaseVsto)') And Exists('$(_VstoInstaller)')"
          Command="&quot;$(_VstoInstaller)&quot; /Install &quot;$(_ReleaseVsto)&quot; /Silent"
          ContinueOnError="true" />
  </Target>
