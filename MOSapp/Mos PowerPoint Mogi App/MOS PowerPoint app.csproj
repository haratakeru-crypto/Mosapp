  <!-- 発行時に VSTO アドインの出力を publish\PowerPointAddIn1 にコピーする（Import の後に定義して確実に実行されるようにする） -->
  <Target Name="AfterPublish">
    <PropertyGroup>
      <_AddInOutDir>$(ProjectDir)PowerPointAddIn1\bin\$(Configuration)\</_AddInOutDir>
      <_AddInPublishDir>$(ProjectDir)$(PublishUrl)PowerPointAddIn1\</_AddInPublishDir>
    </PropertyGroup>
    <MakeDir Directories="$(_AddInPublishDir)" />
    <Exec Command="xcopy /Y /E &quot;$(_AddInOutDir)*.*&quot; &quot;$(_AddInPublishDir)&quot;" IgnoreExitCode="false" />
    <WriteLinesToFile File="$(_AddInPublishDir)README.txt" Lines="PowerPoint 用 VSTO アドイン（採点連携用）;;1. 本フォルダ内の PowerPointAddIn1.vsto をダブルクリックしてインストールしてください。;2. 初回はセキュリティの警告が出る場合があります。信頼してインストールしてください。;3. インストール後、PowerPoint を起動するとアドインが読み込まれ、模擬アプリの採点が正しく動作します。" Overwrite="true" Encoding="UTF-8" />
    <Message Importance="high" Text="VSTO アドインを発行フォルダにコピーしました: $(_AddInPublishDir)" />
  </Target>
</Project>