<Window x:Class="MOS_PowerPoint_app.Views.ReviewPageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="レビューページ - 全問題一覧"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#1E40AF" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- タイマー表示 -->
                <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="12,8" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕐" FontSize="18" Foreground="#1E40AF" Margin="0,0,8,0"/>
                        <TextBlock Name="TimerTextBlock" Text="50:00:00" FontFamily="Consolas" FontSize="18"
                                   Foreground="#1E40AF" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                
                <TextBlock Grid.Column="1" Text="レビューページ - 全問題一覧"
                           Foreground="White" FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <TextBlock Text="任意の問題に戻るには、その問題をクリックします。"
                           FontSize="14" Foreground="#6B7280"
                           Margin="0,0,0,20" HorizontalAlignment="Center"/>
                
                <ItemsControl Name="ProjectsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Margin="0,0,0,20"
                                    Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.1" BlurRadius="8"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding ProjectTitle}"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="#1E40AF" Margin="0,0,0,15"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#F8FAFC"
                                                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="プロジェクト番号・タスク番号"
                                                           FontSize="19" FontWeight="Bold"
                                                           Foreground="#374151" Padding="15,10"/>
                                                <TextBlock Grid.Column="1" Text="解答済み"
                                                           FontSize="19" FontWeight="Bold"
                                                           Foreground="#374151" Padding="15,10"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="あとで見直す"
                                                           FontSize="19" FontWeight="Bold"
                                                           Foreground="#374151" Padding="15,10"
                                                           HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="120"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Background="Transparent"
                                                                    Padding="15,10"
                                                                    Cursor="Hand"
                                                                    Click="TaskButton_Click"
                                                                    BorderThickness="0"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    VerticalContentAlignment="Stretch">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}"
                                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                                            Padding="{TemplateBinding Padding}">
                                                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Background" Value="#E0F2FE"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Button.Style>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding TaskTitle}"
                                                                               FontSize="19" FontWeight="SemiBold"
                                                                               Foreground="#374151" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding Description}"
                                                                               FontSize="17" Foreground="#6B7280"
                                                                               TextWrapping="Wrap" LineHeight="21"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Name="CompletedMark" Text="✓"
                                                                           FontSize="20" Foreground="#10B981"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           Visibility="Collapsed"/>
                                                            </Grid>
                                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Name="FlaggedMark" Text="🚩"
                                                                           FontSize="20"
                                                                           HorizontalAlignment="Center"
                                                                           Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <!-- フッター -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="全問題を確認できます"
                           Foreground="#6B7280" FontSize="14"
                           VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="ShowResultButton" Content="結果の表示"
                            Background="#DC2626" Foreground="White"
                            Padding="20,10" FontWeight="Medium"
                            BorderThickness="0" Click="ShowResultButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#B91C1C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 閉じる系ボタンは非表示（結果の表示のみ表示） -->
                    <Button Name="BackButton" Content="戻る"
                            Background="#1E40AF" Foreground="White"
                            Padding="20,10" FontWeight="Medium"
                            BorderThickness="0" Click="BackButton_Click"
                            Visibility="Collapsed">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
