<Window x:Class="MOSExcelMogiApp.Vocabulary.CoachMarkOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- 校正クリック受信用（通常は非表示・ヒットなし） -->
        <Canvas x:Name="CaptureLayer"
                Background="#01000000"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Cursor="Cross"/>
        <Canvas x:Name="HoleCanvas" IsHitTestVisible="False"/>
        <Border x:Name="Bubble"
                Background="White"
                CornerRadius="8"
                Padding="18,14"
                MaxWidth="360"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="不正解です。"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="MessageText"
                           Text=""
                           FontSize="15"
                           TextWrapping="Wrap"
                           Foreground="#374151"
                           LineHeight="22"/>
                <Button x:Name="DismissButton"
                        Content="閉じる"
                        Margin="0,14,0,0"
                        Padding="16,8"
                        HorizontalAlignment="Right"
                        Background="#1E40AF"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsHitTestVisible="True"
                        Click="DismissButton_Click"/>
            </StackPanel>
        </Border>
        <Path x:Name="Caret"
              Fill="White"
              Stroke="#E5E7EB"
              StrokeThickness="1"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Data="M0,8 L8,0 L16,8 Z"
              Width="16" Height="8"
              IsHitTestVisible="False"/>
    </Grid>
</Window>
