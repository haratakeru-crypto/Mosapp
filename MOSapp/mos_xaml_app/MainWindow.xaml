<Window x:Class="MOSExcelMogiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MOSExcelMogiApp"
        mc:Ignorable="d"
        Title="MOS Excel App" Height="750" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Tab Control -->
        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- 右上に「プロジェクトリセット」ボタンなどを配置 -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,10,0"
                        Panel.ZIndex="100">
                
                <!-- 採点ボタンの表示 -->
                <CheckBox Content="採点ボタンの表示"
                          IsChecked="{Binding ShowScoreButton, Mode=TwoWay}"
                          Margin="0,0,15,0"
                          VerticalAlignment="Center"
                          FontSize="14"/>
                <!-- 一時停止ボタンの表示 -->
                <CheckBox Content="一時停止ボタンの表示"
                          IsChecked="{Binding ShowPauseButton, Mode=TwoWay}"
                          Margin="0,0,15,0"
                          VerticalAlignment="Center"
                          FontSize="14"/>
                <!-- 類題ボタンの表示 -->
                <CheckBox Content="類題ボタン"
                          IsChecked="{Binding ShowVariantButton, Mode=TwoWay}"
                          Margin="0,0,15,0"
                          VerticalAlignment="Center"
                          FontSize="14"/>
                <!-- 類題セット選択（教材モード中のみ変更可） -->
                <ComboBox Width="90"
                          Margin="0,0,15,0"
                          VerticalAlignment="Center"
                          FontSize="14"
                          SelectedIndex="{Binding VariantSetIndex, Mode=TwoWay}"
                          IsEnabled="{Binding CanSelectVariantSet}">
                    <ComboBoxItem Content="類題1"/>
                    <ComboBoxItem Content="類題2"/>
                    <ComboBoxItem Content="類題3"/>
                    <ComboBoxItem Content="類題4"/>
                    <ComboBoxItem Content="類題5"/>
                </ComboBox>
                <!-- プロジェクトリセットボタン -->
                <Button Name="ProjectResetButton"
                        Content="プロジェクトリセット"
                        Margin="0,0,15,0"
                        Padding="15,8"
                        MinWidth="140"
                        FontSize="14"
                        FontWeight="Medium"
                        Click="ProjectResetButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F59E0B"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6"
                                                Margin="2">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="1" Opacity="0.2" BlurRadius="2"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D97706"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#B45309"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            
            <!-- 2タブ構成: 演習(Group1) / 応用編(Group3)。模試①は非表示 -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="#F0F0F3">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="#E8F5E8" BorderBrush="#B3E5D1" BorderThickness="2,2,2,0" CornerRadius="15,15,0,0" Margin="4,0" Padding="20,12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#014030" Direction="135" ShadowDepth="4" Opacity="0.3" BlurRadius="8"/>
                                    </Border.Effect>
                                    <Border CornerRadius="15,15,0,0" Margin="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FFFFFF" Direction="315" ShadowDepth="2" Opacity="0.8" BlurRadius="6"/>
                                        </Border.Effect>
                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="14" TextElement.Foreground="#1A1A1A"/>
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#028760" Offset="0"/>
                                                    <GradientStop Color="#4CAF80" Offset="0.5"/>
                                                    <GradientStop Color="#7FD7A0" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#016B50"/>
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="Bold"/>
                                        <Setter TargetName="Border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#012820" Direction="135" ShadowDepth="6" Opacity="0.4" BlurRadius="10"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            
            <TabItem Header="演習">
                <ScrollViewer Background="#F0F0F3">
                    <Grid Margin="20">
                        <ItemsControl ItemsSource="{Binding ProjectGroups[0].Projects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="5" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" 
                                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="12" Padding="20,15" MinWidth="140" MinHeight="60">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#028760" Offset="0"/>
                                                            <GradientStop Color="#4CAF80" Offset="0.5"/>
                                                            <GradientStop Color="#7FD7A0" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="20"
                                                                    Margin="4">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#014030" Direction="135" ShadowDepth="8" Opacity="0.4" BlurRadius="15"/>
                                                                </Border.Effect>
                                                                <Border CornerRadius="20" Margin="2">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect Color="#B3E5D1" Direction="315" ShadowDepth="6" Opacity="0.8" BlurRadius="12"/>
                                                                    </Border.Effect>
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#0A9B70" Offset="0"/>
                                                                    <GradientStop Color="#5CC390" Offset="0.5"/>
                                                                    <GradientStop Color="#8FEBB0" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#016B50" Offset="0"/>
                                                                    <GradientStop Color="#3A9B70" Offset="0.5"/>
                                                                    <GradientStop Color="#6FC390" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            CornerRadius="20"
                                                                            Margin="4">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect Color="#012820" Direction="135" ShadowDepth="4" Opacity="0.5" BlurRadius="8"/>
                                                                        </Border.Effect>
                                                                        <Border CornerRadius="20" Margin="2">
                                                                            <Border.Effect>
                                                                                <DropShadowEffect Color="#A3D9C1" Direction="315" ShadowDepth="2" Opacity="0.6" BlurRadius="6"/>
                                                                            </Border.Effect>
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="応用編">
                <ScrollViewer Background="#F0F0F3">
                    <Grid Margin="20">
                        <ItemsControl ItemsSource="{Binding ProjectGroups[1].Projects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="5" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" 
                                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="12" Padding="20,15" MinWidth="140" MinHeight="60">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#00b865" Offset="0"/>
                                                            <GradientStop Color="#4DC685" Offset="0.5"/>
                                                            <GradientStop Color="#7FD4A5" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="20"
                                                                    Margin="4">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#005832" Direction="135" ShadowDepth="8" Opacity="0.4" BlurRadius="15"/>
                                                                </Border.Effect>
                                                                <Border CornerRadius="20" Margin="2">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect Color="#B3E5D1" Direction="315" ShadowDepth="6" Opacity="0.8" BlurRadius="12"/>
                                                                    </Border.Effect>
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#0CC675" Offset="0"/>
                                                                    <GradientStop Color="#5DD695" Offset="0.5"/>
                                                                    <GradientStop Color="#8FE4B5" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#009A55" Offset="0"/>
                                                                    <GradientStop Color="#3CB675" Offset="0.5"/>
                                                                    <GradientStop Color="#6FC495" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            CornerRadius="20"
                                                                            Margin="4">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect Color="#004622" Direction="135" ShadowDepth="4" Opacity="0.5" BlurRadius="8"/>
                                                                        </Border.Effect>
                                                                        <Border CornerRadius="20" Margin="2">
                                                                            <Border.Effect>
                                                                                <DropShadowEffect Color="#A3D9C1" Direction="315" ShadowDepth="2" Opacity="0.6" BlurRadius="6"/>
                                                                            </Border.Effect>
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

            <!-- 前試験の Excel 終了待ち（プロジェクト一覧エリアのみ。短い待機では ViewModel 側で表示しない） -->
            <Border Panel.ZIndex="50"
                    Visibility="{Binding IsShutdownWaitOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#55000000"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                        Background="#FFFDFDFD" CornerRadius="10" Padding="18,12" MaxWidth="400"
                        BorderBrush="#C8C8C8" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" Opacity="0.25" BlurRadius="8"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#333333"
                                   Text="前の試験の終了処理中です。少々お待ちください。"/>
                        <ProgressBar Height="6" Margin="0,12,0,0"
                                     IsIndeterminate="True"
                                     Foreground="#028760"
                                     Background="#E8E8E8"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Border>
            </Grid>
        </Grid>
        
        <!-- Result Display -->
        <Border Grid.Row="1" Margin="20,10" Background="#FFFFFF" BorderBrush="#A0A0A0" BorderThickness="2" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="3" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>
            <TextBlock Text="{Binding ResultMessage}" Margin="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="40"/>
        </Border>
         
         <!-- Excel Overlay UI -->
         <Grid Grid.RowSpan="3">
             <Grid.Style>
                 <Style TargetType="Grid">
                     <Setter Property="Visibility" Value="Collapsed"/>
                     <Style.Triggers>
                         <DataTrigger Binding="{Binding IsExcelOverlayVisible}" Value="True">
                             <Setter Property="Visibility" Value="Visible"/>
                         </DataTrigger>
                     </Style.Triggers>
                 </Style>
             </Grid.Style>
             <Grid.RowDefinitions>
                 <RowDefinition Height="4*"/>
                 <RowDefinition Height="1*"/>
             </Grid.RowDefinitions>
             
             <!-- Transparent overlay for top 80% -->
             <Border Grid.Row="0" Background="Transparent"/>
             
             <!-- Bottom 20% UI Panel -->
             <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,2,0,0">
                 <Border.Effect>
                     <DropShadowEffect Color="Black" Direction="90" ShadowDepth="3" Opacity="0.3" BlurRadius="5"/>
                 </Border.Effect>
                 
                 <Grid Margin="20">
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="Auto"/>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                         <ColumnDefinition Width="Auto"/>
                     </Grid.ColumnDefinitions>
                     
                     <!-- Project Info -->
                     <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                         <TextBlock Text="現在のプロジェクト: " FontWeight="Bold" VerticalAlignment="Center"/>
                         <TextBlock Text="{Binding CurrentProject.Name}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0066CC"/>
                     </StackPanel>
                     
                     <!-- Task Progress Area (placeholder for future JSON tasks) -->
                     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                         <TextBlock Text="タスク進行状況: " FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                         <Border Background="#E0E0E0" BorderBrush="#A0A0A0" BorderThickness="1" CornerRadius="3" Padding="5">
                             <TextBlock Text="準備中..." FontStyle="Italic"/>
                         </Border>
                     </StackPanel>
                     
                     <!-- Action Buttons -->
                     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                         <Button Content="採点" Command="{Binding ScoreCommand}" Margin="0,0,10,0" Padding="20,8" MinWidth="80">
                             <Button.Style>
                                 <Style TargetType="Button">
                                     <Setter Property="Background">
                                         <Setter.Value>
                                             <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                 <GradientStop Color="#4CAF50" Offset="0"/>
                                                 <GradientStop Color="#45A049" Offset="1"/>
                                             </LinearGradientBrush>
                                         </Setter.Value>
                                     </Setter>
                                     <Setter Property="Foreground" Value="White"/>
                                     <Setter Property="BorderBrush" Value="#45A049"/>
                                     <Setter Property="BorderThickness" Value="2"/>
                                     <Setter Property="Template">
                                         <Setter.Value>
                                             <ControlTemplate TargetType="Button">
                                                 <Border Background="{TemplateBinding Background}" 
                                                         BorderBrush="{TemplateBinding BorderBrush}" 
                                                         BorderThickness="{TemplateBinding BorderThickness}" 
                                                         CornerRadius="6">
                                                     <Border.Effect>
                                                         <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.3" BlurRadius="3"/>
                                                     </Border.Effect>
                                                     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                 </Border>
                                             </ControlTemplate>
                                         </Setter.Value>
                                     </Setter>
                                     <Style.Triggers>
                                         <Trigger Property="IsMouseOver" Value="True">
                                             <Setter Property="Background">
                                                 <Setter.Value>
                                                     <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                         <GradientStop Color="#5CBF60" Offset="0"/>
                                                         <GradientStop Color="#4CAF50" Offset="1"/>
                                                     </LinearGradientBrush>
                                                 </Setter.Value>
                                             </Setter>
                                         </Trigger>
                                         <Trigger Property="IsPressed" Value="True">
                                             <Setter Property="Background">
                                                 <Setter.Value>
                                                     <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                         <GradientStop Color="#45A049" Offset="0"/>
                                                         <GradientStop Color="#5CBF60" Offset="1"/>
                                                     </LinearGradientBrush>
                                                 </Setter.Value>
                                             </Setter>
                                         </Trigger>
                                     </Style.Triggers>
                                 </Style>
                             </Button.Style>
                         </Button>
                         
                         <Button Content="試験終了" Command="{Binding EndExamCommand}" Padding="20,8" MinWidth="80">
                             <Button.Style>
                                 <Style TargetType="Button">
                                     <Setter Property="Background">
                                         <Setter.Value>
                                             <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                 <GradientStop Color="#F44336" Offset="0"/>
                                                 <GradientStop Color="#D32F2F" Offset="1"/>
                                             </LinearGradientBrush>
                                         </Setter.Value>
                                     </Setter>
                                     <Setter Property="Foreground" Value="White"/>
                                     <Setter Property="BorderBrush" Value="#D32F2F"/>
                                     <Setter Property="BorderThickness" Value="2"/>
                                     <Setter Property="Template">
                                         <Setter.Value>
                                             <ControlTemplate TargetType="Button">
                                                 <Border Background="{TemplateBinding Background}" 
                                                         BorderBrush="{TemplateBinding BorderBrush}" 
                                                         BorderThickness="{TemplateBinding BorderThickness}" 
                                                         CornerRadius="6">
                                                     <Border.Effect>
                                                         <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" Opacity="0.3" BlurRadius="3"/>
                                                     </Border.Effect>
                                                     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                 </Border>
                                             </ControlTemplate>
                                         </Setter.Value>
                                     </Setter>
                                     <Style.Triggers>
                                         <Trigger Property="IsMouseOver" Value="True">
                                             <Setter Property="Background">
                                                 <Setter.Value>
                                                     <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                         <GradientStop Color="#F66356" Offset="0"/>
                                                         <GradientStop Color="#F44336" Offset="1"/>
                                                     </LinearGradientBrush>
                                                 </Setter.Value>
                                             </Setter>
                                         </Trigger>
                                         <Trigger Property="IsPressed" Value="True">
                                             <Setter Property="Background">
                                                 <Setter.Value>
                                                     <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                         <GradientStop Color="#D32F2F" Offset="0"/>
                                                         <GradientStop Color="#F66356" Offset="1"/>
                                                     </LinearGradientBrush>
                                                 </Setter.Value>
                                             </Setter>
                                         </Trigger>
                                     </Style.Triggers>
                                 </Style>
                             </Button.Style>
                         </Button>
                     </StackPanel>
                 </Grid>
             </Border>
         </Grid>
     </Grid>
 </Window>
