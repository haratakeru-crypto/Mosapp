<Window x:Class="MOSExcelMogiApp.Views.UiTestAppBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UIテスト - App Bar" 
        SizeToContent="Height"
        Width="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <!-- メインコンテナ -->
    <Border Background="#F5F5F5" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- ヘッダーバー -->
            <Border Grid.Row="0" Background="#1E40AF" CornerRadius="8,8,0,0" Margin="0,0,0,6">
                <Grid Margin="20,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左側: タイマーとボタン -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🕐" FontSize="20" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Name="TimerTextBlock" Text="50:00:00" FontFamily="Consolas" FontSize="20" Foreground="White" FontWeight="Bold" Margin="0,0,0,0" VerticalAlignment="Center"/>
                        <Button Content="レビューページ" 
                                Background="White" 
                                Foreground="#1E40AF" 
                                Padding="24,10" 
                                Margin="20,0,0,0"
                                BorderThickness="0"
                                FontWeight="Medium"
                                FontSize="16"
                                Click="ReviewPageButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    
                    <!-- 中央: タイトル -->
                    <TextBlock Grid.Column="1" 
                               Name="ProjectInfoTextBlock"
                               Text="プロジェクト 1/10" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    
                    <!-- 右側: ボタンとアイコン -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,10,0">

                        <Button Name="ScoreButton" Content="採点" 
                                Background="White" 
                                Foreground="#1E40AF" 
                                Padding="24,10" 
                                Margin="0,0,10,0"
                                BorderThickness="0"
                                FontWeight="Medium"
                                FontSize="16"
                                Click="ScoreButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Name="PauseButton" Content="一時停止" 
                                Background="White" 
                                Foreground="#1E40AF" 
                                Padding="24,10" 
                                Margin="0,0,10,0"
                                BorderThickness="0"
                                FontWeight="Medium"
                                FontSize="16"
                                Click="PauseButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Name="ResetButton" Content="リセット" 
                                Background="White" 
                                Foreground="#1E40AF" 
                                Padding="24,10" 
                                Margin="0,0,10,0"
                                BorderThickness="0"
                                FontWeight="Medium"
                                FontSize="16"
                                Click="ResetButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <Button Content="次のプロジェクト" 
                                Background="White" 
                                Foreground="#1E40AF" 
                                Padding="24,10" 
                                Margin="0,0,10,0"
                                BorderThickness="0"
                                FontWeight="Medium"
                                FontSize="16"
                                Click="NextProject_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- アイコンボタン -->
                        <Button Width="32" Height="32" 
                                Background="White" 
                                BorderThickness="0"
                                Margin="0,0,5,0">
                            <TextBlock Text="↓" FontSize="14" Foreground="#1E40AF" FontWeight="Bold"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <Button Width="32" Height="32" 
                                Background="White" 
                                BorderThickness="0">
                            <TextBlock Text="□" FontSize="14" Foreground="#1E40AF" FontWeight="Bold"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F4F6"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- メインコンテンツエリア -->
            <Border Grid.Row="1" Background="White" Margin="20,0,20,0">
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- ナビゲーション -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                        <Button Width="96" Height="32" 
                                Background="#D1D5DB" 
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                Click="PreviousTask_Click">
                            <TextBlock Text="←" FontSize="16" Foreground="White" FontWeight="Bold"/>
                        </Button>
                        
                        <!-- タスク番号ボタン（1-7） -->
                        <Button Name="TaskButton1" Width="120" Height="32" 
                                Background="White" 
                                BorderBrush="#9CA3AF" 
                                BorderThickness="2"
                                Click="TaskButton_Click"
                                Tag="1"
                                Margin="0,0,5,0">
                            <Grid Width="120" Height="32">
                                <TextBlock Name="TaskText1" Text="1" FontSize="16" Foreground="Black" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Name="Check1" Text="✓" FontSize="16" Foreground="Green" FontWeight="Bold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                           Visibility="Collapsed"/>
                                <TextBlock Name="Flag1" Text="🚩" FontSize="16" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        
                        <Button Name="TaskButton2" Width="120" Height="32" 
                                Background="#D1D5DB" 
                                BorderThickness="0"
                                Click="TaskButton_Click"
                                Tag="2"
                                Margin="0,0,5,0">
                            <Grid Width="120" Height="32">
                                <TextBlock Name="TaskText2" Text="2" FontSize="16" Foreground="Black" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Name="Check2" Text="✓" FontSize="16" Foreground="Green" FontWeight="Bold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                           Visibility="Collapsed"/>
                                <TextBlock Name="Flag2" Text="🚩" FontSize="16" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        
                        <Button Name="TaskButton3" Width="120" Height="32" 
                                Background="#D1D5DB" 
                                BorderThickness="0"
                                Click="TaskButton_Click"
                                Tag="3"
                                Margin="0,0,5,0">
                            <Grid Width="120" Height="32">
                                <TextBlock Name="TaskText3" Text="3" FontSize="16" Foreground="Black" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Name="Check3" Text="✓" FontSize="16" Foreground="Green" FontWeight="Bold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                           Visibility="Collapsed"/>
                                <TextBlock Name="Flag3" Text="🚩" FontSize="16" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        
                        <Button Name="TaskButton4" Width="120" Height="32" 
                                Background="#D1D5DB" 
                                BorderThickness="0"
                                Click="TaskButton_Click"
                                Tag="4"
                                Margin="0,0,5,0">
                            <Grid Width="120" Height="32">
                                <TextBlock Name="TaskText4" Text="4" FontSize="16" Foreground="Black" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Name="Check4" Text="✓" FontSize="16" Foreground="Green" FontWeight="Bold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                           Visibility="Collapsed"/>
                                <TextBlock Name="Flag4" Text="🚩" FontSize="16" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        
                        <Button Name="TaskButton5" Width="120" Height="32" 
                                Background="#D1D5DB" 
                                BorderThickness="0"
                                Click="TaskButton_Click"
                                Tag="5"
                                Margin="0,0,5,0">
                            <Grid Width="120" Height="32">
                                <TextBlock Name="TaskText5" Text="5" FontSize="16" Foreground="Black" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Name="Check5" Text="✓" FontSize="16" Foreground="Green" FontWeight="Bold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                           Visibility="Collapsed"/>
                                <TextBlock Name="Flag5" Text="🚩" FontSize="16" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        
                        <Button Name="TaskButton6" Width="120" Height="32" 
                                Background="#D1D5DB" 
                                BorderThickness="0"
                                Click="TaskButton_Click"
                                Tag="6"
                                Margin="0,0,5,0">
                            <Grid Width="120" Height="32">
                                <TextBlock Name="TaskText6" Text="6" FontSize="16" Foreground="Black" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Name="Check6" Text="✓" FontSize="16" Foreground="Green" FontWeight="Bold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                           Visibility="Collapsed"/>
                                <TextBlock Name="Flag6" Text="🚩" FontSize="16" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        
                        <Button Name="TaskButton7" Width="120" Height="32" 
                                Background="#D1D5DB" 
                                BorderThickness="0"
                                Click="TaskButton_Click"
                                Tag="7"
                                Margin="0,0,10,0">
                            <Grid Width="120" Height="32">
                                <TextBlock Name="TaskText7" Text="7" FontSize="16" Foreground="Black" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Name="Check7" Text="✓" FontSize="16" Foreground="Green" FontWeight="Bold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                           Visibility="Collapsed"/>
                                <TextBlock Name="Flag7" Text="🚩" FontSize="16" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        
                        <Button Width="96" Height="32" 
                                Background="#D1D5DB" 
                                BorderThickness="0"
                                Click="NextTask_Click">
                            <TextBlock Text="→" FontSize="16" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                    
                    <!-- 指示テキスト -->
                    <Border Grid.Row="1" 
                            Background="White" 
                            BorderBrush="#E5E7EB" 
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="30"
                            Margin="0,0,0,30">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 上段: 指示テキスト -->
                            <TextBlock Grid.Row="0"
                                       Name="TaskDescriptionTextBlock" 
                                       Text="シート[売上一覧]の印刷の向きを横向きに設定します。"
                                       FontSize="16"
                                       Foreground="#374151"
                                       LineHeight="24"
                                       TextWrapping="Wrap"/>

                            <!-- 下段: アクションボタン（中央寄せ） -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Name="CompleteButton" Content="解答済みにする" 
                                        Background="Transparent"
                                        Foreground="#1E40AF" 
                                        BorderThickness="0"
                                        FontWeight="Medium"
                                        FontSize="16"
                                        Padding="0,10,0,10"
                                        Margin="0,0,24,0"
                                        Click="CompleteButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Name="FlagButton" Content="あとで見直す" 
                                        Background="Transparent"
                                        Foreground="#1E40AF" 
                                        BorderThickness="0"
                                        FontWeight="Medium"
                                        FontSize="16"
                                        Padding="0,10,0,10"
                                        Margin="0,0,24,0"
                                        Click="FlagButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="試験後にコメントする" 
                                        Background="Transparent"
                                        Foreground="#1E40AF" 
                                        BorderThickness="0"
                                        FontWeight="Medium"
                                        FontSize="16"
                                        Padding="0,10,0,10"
                                        Margin="0,0,16,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 右側: 終了ボタン（ここに配置） -->
                                <Button Content="終了" 
                                        Background="#EF4444" 
                                        Foreground="White" 
                                        Padding="15,8" 
                                        BorderThickness="0"
                                        FontWeight="Medium"
                                        Click="CloseButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#B91C1C"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- アクションボタン行は上の指示枠内に移動 -->
                </Grid>
            </Border>
            
            
        </Grid>
    </Border>
</Window>
