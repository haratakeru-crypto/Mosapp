<Window x:Class="MOSExcelMogiApp.Views.AnswerGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解答手順"
        Width="720"
        Height="640"
        MinWidth="420"
        MinHeight="320"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        Background="#F8FAFC">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F766E" Padding="12,10">
            <DockPanel>
                <Button x:Name="CloseButton"
                        Content="閉じる"
                        DockPanel.Dock="Right"
                        Width="72"
                        Height="28"
                        Margin="8,0,0,0"
                        Click="CloseButton_Click"
                        Background="#115E59"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <TextBlock x:Name="HeaderTextBlock"
                           Text="解答手順 — タスクを選ぶ"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <ScrollViewer x:Name="TaskListScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TaskListPanel"/>
            </ScrollViewer>

            <Grid x:Name="StepPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="White"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1">
                    <Image x:Name="StepImage"
                           Stretch="Fill"
                           Margin="8"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>
                </ScrollViewer>

                <TextBlock x:Name="CaptionTextBlock"
                           Grid.Row="1"
                           Margin="0,10,0,6"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="#0F172A"/>

                <TextBlock x:Name="ProgressTextBlock"
                           Grid.Row="2"
                           FontSize="12"
                           Foreground="#64748B"
                           HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock x:Name="EmptyMessageTextBlock"
                       Text="このプロジェクトの手順はまだありません"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#475569"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="16"/>
        </Grid>

        <Border Grid.Row="2" Background="#EEF2FF" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ズーム"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="#334155"
                               FontSize="12"/>
                    <ComboBox x:Name="ZoomComboBox"
                              Width="118"
                              Height="28"
                              IsEditable="True"
                              StaysOpenOnEdit="True"
                              VerticalContentAlignment="Center"
                              Margin="0,0,6,0"
                              ToolTip="一覧から選ぶか％を入力（Enterで確定）"
                              SelectionChanged="ZoomComboBox_SelectionChanged"
                              KeyDown="ZoomComboBox_KeyDown"
                              LostKeyboardFocus="ZoomComboBox_LostKeyboardFocus"/>
                    <Button x:Name="TaskListButton"
                            Content="タスク一覧"
                            Padding="10,6"
                            Click="TaskListButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PrevButton"
                            Content="戻る"
                            Width="72"
                            Height="32"
                            Margin="0,0,6,0"
                            Click="PrevButton_Click"/>
                    <Button x:Name="NextButton"
                            Content="次へ"
                            Width="72"
                            Height="32"
                            Click="NextButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
