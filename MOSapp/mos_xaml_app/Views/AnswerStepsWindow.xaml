<Window x:Class="MOSExcelMogiApp.Views.AnswerStepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解答手順"
        WindowStartupLocation="CenterScreen"
        Width="560"
        Height="480"
        MinWidth="400"
        MinHeight="300"
        Topmost="True"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#C2410C" Padding="15,10">
            <TextBlock x:Name="HeaderTextBlock"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="16,12">
            <TextBlock x:Name="AnswerStepsTextBlock"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10">
            <Button Content="閉じる"
                    Width="100"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="CloseButton_Click"
                    Background="#C2410C"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Medium"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EA580C"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
    </Grid>
</Window>
