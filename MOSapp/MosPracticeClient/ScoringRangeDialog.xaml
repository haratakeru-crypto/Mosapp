<Window x:Class="MosPracticeClient.ScoringRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="採点する範囲"
        Width="420"
        SizeToContent="Height"
        MinHeight="280"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="採点するプロジェクトの範囲を選んでください"
                   FontSize="14" Foreground="#374151" TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="Range1To3" Content="プロジェクト1～3" GroupName="ScoringRange"
                         Margin="0,0,0,8" FontSize="14" Checked="RangeOption_Changed"/>
            <RadioButton x:Name="Range4To6" Content="プロジェクト4～6" GroupName="ScoringRange"
                         Margin="0,0,0,8" FontSize="14" Checked="RangeOption_Changed"/>
            <RadioButton x:Name="Range7To9" Content="プロジェクト7～9" GroupName="ScoringRange"
                         Margin="0,0,0,8" FontSize="14" Checked="RangeOption_Changed"/>
            <RadioButton x:Name="Range1To9" Content="プロジェクト1～9" GroupName="ScoringRange"
                         Margin="0,0,0,8" FontSize="14" Checked="RangeOption_Changed"/>
            <RadioButton x:Name="RangeAll" Content="すべてのプロジェクト" GroupName="ScoringRange"
                         Margin="0,0,0,8" FontSize="14" IsChecked="True" Checked="RangeOption_Changed"/>
            <RadioButton x:Name="RangeCustom" Content="カスタム" GroupName="ScoringRange"
                         Margin="0,0,0,8" FontSize="14" Checked="RangeOption_Changed"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="CustomScroll"
                      MaxHeight="160" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      Margin="20,0,0,12">
            <WrapPanel x:Name="CustomCheckPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="採点開始" Name="StartButton"
                    Width="100" Height="32"
                    Background="#1E40AF" Foreground="White"
                    BorderThickness="0"
                    IsDefault="True"
                    Click="StartButton_Click"
                    Margin="0,0,10,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#93C5FD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="キャンセル" Name="CancelButton"
                    Width="100" Height="32"
                    Background="#6B7280" Foreground="White"
                    BorderThickness="0"
                    IsCancel="True"
                    Click="CancelButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4B5563"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
