<UserControl x:Class="MosPracticeClient.GameTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="GameButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding ButtonBackground, ElementName=Root}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="MinWidth" Value="560"/>
            <Setter Property="MinHeight" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer" Background="{TemplateBinding Background}" CornerRadius="20" Margin="4">
                            <Border.Effect>
                                <DropShadowEffect Color="#555555" Direction="135" ShadowDepth="8" Opacity="0.4" BlurRadius="15"/>
                            </Border.Effect>
                            <Border CornerRadius="20" Margin="2" Padding="24,12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="#F0F0F3">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource GameButtonStyle}" Click="JudgeButton_Click">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                    <Run Text="3秒で解けるか解けないか判断！" FontSize="16" FontWeight="Medium"/>
                    <LineBreak/>
                    <Run Text="3秒ジャッジ！" FontSize="26"/>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource GameButtonStyle}" Click="SnipeButton_Click">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                    <Run Text="3秒で正解を見抜く！" FontSize="16" FontWeight="Medium"/>
                    <LineBreak/>
                    <Run Text="3秒スナイプ！" FontSize="26"/>
                </TextBlock>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
