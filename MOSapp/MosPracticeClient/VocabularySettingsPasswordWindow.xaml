<Window x:Class="MosPracticeClient.VocabularySettingsPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="White">
    <StackPanel Margin="24,20">
        <TextBlock Text="設定を開くにはパスワードを入力してください。"
                   FontSize="15"
                   TextWrapping="Wrap"
                   Foreground="#1F2937"
                   Margin="0,0,0,12"/>
        <PasswordBox x:Name="PasswordInput"
                     FontSize="16"
                     Height="34"
                     Padding="6,4"
                     KeyDown="PasswordInput_KeyDown"/>
        <TextBlock x:Name="ErrorText"
                   Text="パスワードが違います。"
                   Foreground="#DC2626"
                   FontSize="13"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="キャンセル"
                    MinWidth="96"
                    Height="34"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button Content="OK"
                    MinWidth="96"
                    Height="34"
                    Background="#1E40AF"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="OkButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
