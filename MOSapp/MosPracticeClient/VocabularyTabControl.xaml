<UserControl x:Class="MosPracticeClient.VocabularyTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F0F3">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720" Margin="24">
            <TextBlock Text="タブやボタンを探そう！"
                       FontFamily="HG創英角ポップ体, HGP創英角ポップ体, メイリオ"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="#1F2937"
                       Margin="0,0,0,32"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="FromProblemButton" Content="問題文から"
                        MinWidth="180" Height="52" FontSize="16" FontWeight="SemiBold"
                        Margin="0,0,16,0" Cursor="Hand" Click="FromProblemButton_Click"/>
                <Button x:Name="KeywordOnlyButton" Content="キーワード"
                        MinWidth="180" Height="52" FontSize="16" FontWeight="SemiBold"
                        Cursor="Hand" Click="KeywordOnlyButton_Click"/>
            </StackPanel>

            <Border x:Name="DescriptionPanel"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16"
                    Margin="0,28,0,0"
                    MinHeight="80">
                <TextBlock x:Name="DescriptionText"
                           TextWrapping="Wrap"
                           FontSize="16"
                           Foreground="#1F2937"
                           LineHeight="26"/>
            </Border>

            <StackPanel x:Name="CategoryPanel"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <Button x:Name="CategoryTabButton" Content="タブ・ボタン"
                        MinWidth="140" Height="44" FontSize="15" FontWeight="SemiBold"
                        Margin="0,0,12,0" Cursor="Hand" Click="CategoryTabButton_Click"/>
                <Button x:Name="CategoryFunctionButton" Content="関数"
                        MinWidth="140" Height="44" FontSize="15" FontWeight="SemiBold"
                        Margin="0,0,12,0" Cursor="Hand" Click="CategoryFunctionButton_Click"/>
                <Button x:Name="CategoryBothButton" Content="両方"
                        MinWidth="140" Height="44" FontSize="15" FontWeight="SemiBold"
                        Cursor="Hand" Click="CategoryBothButton_Click"/>
            </StackPanel>

            <Button x:Name="StartButton" Content="スタート"
                    Visibility="Collapsed"
                    MinWidth="180" Height="52" FontSize="18" FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    Cursor="Hand"
                    Background="#FF5A36" Foreground="White" BorderThickness="0"
                    Click="StartButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
