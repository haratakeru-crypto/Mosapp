<UserControl x:Class="MosPracticeClient.ScoringLogListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F0F3">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="採点ログ"
                   FontSize="22" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,12"/>
        <ListBox x:Name="LogList"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Click="LogItem_Click" Cursor="Hand" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <Border Background="White" CornerRadius="8" Padding="16,14"
                                BorderBrush="#D1D5DB" BorderThickness="1">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                        </Border>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText"
                   Grid.Row="1"
                   Text="まだ採点ログはありません。レビューページの「結果の表示」で採点するとここに残ります。"
                   FontSize="14" Foreground="#6B7280" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="4,8,4,0"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
